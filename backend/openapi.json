{
  "openapi": "3.1.0",
  "info": {
    "title": "Taskflow API",
    "version": "1.0.0",
    "description": "REST API for Taskflow accounts, tasks, categories, and in-app notifications. Authentication uses short-lived HTTP-only access cookies and rotating refresh cookies."
  },
  "servers": [
    { "url": "http://localhost:5000/api", "description": "Local development API" }
  ],
  "tags": [
    { "name": "Health" },
    { "name": "Authentication" },
    { "name": "Tasks" },
    { "name": "Categories" },
    { "name": "Notifications" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Check API and database health",
        "responses": {
          "200": {
            "description": "API is available; database status is included.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register an account and start a session",
        "requestBody": { "$ref": "#/components/requestBodies/Register" },
        "responses": {
          "201": { "description": "Account created and cookies set.", "headers": { "Set-Cookie": { "$ref": "#/components/headers/SetCookie" } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Authenticate and start a session",
        "requestBody": { "$ref": "#/components/requestBodies/Login" },
        "responses": {
          "200": { "description": "Authenticated and cookies set.", "headers": { "Set-Cookie": { "$ref": "#/components/headers/SetCookie" } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Rotate the refresh token and issue a new access token",
        "security": [{ "refreshCookie": [] }],
        "responses": {
          "200": { "description": "Tokens rotated and user returned.", "headers": { "Set-Cookie": { "$ref": "#/components/headers/SetCookie" } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Revoke the current refresh session and clear cookies",
        "responses": { "204": { "description": "Session revoked and cookies cleared." } }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get the current user or an anonymous session",
        "responses": {
          "200": {
            "description": "Current user, or null when signed out.",
            "content": { "application/json": { "schema": { "type": "object", "required": ["user"], "properties": { "user": { "oneOf": [{ "$ref": "#/components/schemas/User" }, { "type": "null" }] } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List, filter, search, sort, and paginate owned tasks",
        "security": [{ "accessCookie": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 } },
          { "name": "search", "in": "query", "schema": { "type": "string", "maxLength": 100 } },
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/TaskStatus" } },
          { "name": "priority", "in": "query", "schema": { "$ref": "#/components/schemas/Priority" } },
          { "name": "category", "in": "query", "schema": { "type": "string", "description": "Category ObjectId or uncategorized." } },
          { "name": "due", "in": "query", "schema": { "type": "string", "enum": ["today", "upcoming", "overdue"] } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["createdAt", "dueDate", "priority", "title", "updatedAt"], "default": "createdAt" } },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" } },
          { "name": "timezoneOffset", "in": "query", "schema": { "type": "integer", "minimum": -840, "maximum": 840, "default": 0 } }
        ],
        "responses": {
          "200": { "description": "Paginated task list.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskList" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create a task",
        "security": [{ "accessCookie": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/TaskCreate" },
        "responses": {
          "201": { "description": "Task created.", "content": { "application/json": { "schema": { "type": "object", "properties": { "task": { "$ref": "#/components/schemas/Task" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/tasks/statistics": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get dashboard task statistics",
        "security": [{ "accessCookie": [] }],
        "parameters": [{ "name": "timezoneOffset", "in": "query", "schema": { "type": "integer", "minimum": -840, "maximum": 840, "default": 0 } }],
        "responses": {
          "200": { "description": "Counts for current user's tasks.", "content": { "application/json": { "schema": { "type": "object", "properties": { "statistics": { "$ref": "#/components/schemas/TaskStatistics" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/tasks/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
      "get": {
        "tags": ["Tasks"],
        "summary": "Get an owned task",
        "security": [{ "accessCookie": [] }],
        "responses": {
          "200": { "description": "Task details.", "content": { "application/json": { "schema": { "type": "object", "properties": { "task": { "$ref": "#/components/schemas/Task" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Tasks"],
        "summary": "Update an owned task",
        "security": [{ "accessCookie": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/TaskUpdate" },
        "responses": {
          "200": { "description": "Task updated.", "content": { "application/json": { "schema": { "type": "object", "properties": { "task": { "$ref": "#/components/schemas/Task" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete an owned task and its reminders",
        "security": [{ "accessCookie": [] }],
        "responses": { "204": { "description": "Task deleted." }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/categories": {
      "get": {
        "tags": ["Categories"],
        "summary": "List owned categories",
        "security": [{ "accessCookie": [] }],
        "responses": {
          "200": { "description": "Current user's categories.", "content": { "application/json": { "schema": { "type": "object", "properties": { "categories": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Categories"],
        "summary": "Create a category",
        "security": [{ "accessCookie": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 32 }, "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } } } } }
        },
        "responses": {
          "201": { "description": "Category created.", "content": { "application/json": { "schema": { "type": "object", "properties": { "category": { "$ref": "#/components/schemas/Category" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/categories/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
      "patch": {
        "tags": ["Categories"],
        "summary": "Update an owned category",
        "security": [{ "accessCookie": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "minProperties": 1, "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 32 }, "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } } } } }
        },
        "responses": {
          "200": { "description": "Category updated.", "content": { "application/json": { "schema": { "type": "object", "properties": { "category": { "$ref": "#/components/schemas/Category" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Categories"],
        "summary": "Delete category and unassign its tasks",
        "security": [{ "accessCookie": [] }],
        "responses": { "204": { "description": "Category deleted." }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/notifications": {
      "get": {
        "tags": ["Notifications"],
        "summary": "List recent notifications and unread count",
        "security": [{ "accessCookie": [] }],
        "responses": {
          "200": { "description": "Up to 50 notifications and unread count.", "content": { "application/json": { "schema": { "type": "object", "required": ["data", "unreadCount"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Notification" } }, "unreadCount": { "type": "integer" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/notifications/read-all": {
      "patch": {
        "tags": ["Notifications"],
        "summary": "Mark all notifications read",
        "security": [{ "accessCookie": [] }],
        "responses": { "204": { "description": "Notifications marked read." }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/notifications/{id}/read": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
      "patch": {
        "tags": ["Notifications"],
        "summary": "Mark an owned notification read",
        "security": [{ "accessCookie": [] }],
        "responses": {
          "200": { "description": "Notification marked read.", "content": { "application/json": { "schema": { "type": "object", "properties": { "notification": { "$ref": "#/components/schemas/Notification" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/notifications/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
      "delete": {
        "tags": ["Notifications"],
        "summary": "Dismiss an owned notification",
        "security": [{ "accessCookie": [] }],
        "responses": { "204": { "description": "Notification dismissed." }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "accessCookie": { "type": "apiKey", "in": "cookie", "name": "todo_session" },
      "refreshCookie": { "type": "apiKey", "in": "cookie", "name": "todo_refresh" }
    },
    "parameters": {
      "ObjectId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-fA-F0-9]{24}$" } }
    },
    "headers": {
      "SetCookie": { "description": "HTTP-only access and refresh cookies are set or rotated.", "schema": { "type": "string" } }
    },
    "requestBodies": {
      "Register": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["name", "email", "password", "confirmPassword"], "properties": { "name": { "type": "string", "minLength": 2, "maxLength": 60 }, "email": { "type": "string", "format": "email", "maxLength": 254 }, "password": { "type": "string", "format": "password", "minLength": 8, "maxLength": 128 }, "confirmPassword": { "type": "string", "format": "password", "minLength": 8, "maxLength": 128 } } } } }
      },
      "Login": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "format": "password", "minLength": 8, "maxLength": 128 } } } } }
      },
      "TaskCreate": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskInput" } } }
      },
      "TaskUpdate": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskPatch" } } }
      }
    },
    "schemas": {
      "Health": { "type": "object", "required": ["status", "database"], "properties": { "status": { "type": "string", "example": "ok" }, "database": { "type": "string", "example": "connected" } } },
      "User": { "type": "object", "required": ["id", "name", "email"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "email": { "type": "string", "format": "email" } } },
      "TaskStatus": { "type": "string", "enum": ["todo", "in-progress", "completed"] },
      "Priority": { "type": "string", "enum": ["low", "medium", "high"] },
      "Category": {
        "type": "object",
        "required": ["_id", "name", "color"],
        "properties": {
          "_id": { "type": "string" },
          "name": { "type": "string", "maxLength": 32 },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      },
      "TaskInput": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "description": { "type": "string", "maxLength": 2000 },
          "status": { "$ref": "#/components/schemas/TaskStatus" },
          "priority": { "$ref": "#/components/schemas/Priority" },
          "category": { "oneOf": [{ "type": "string", "pattern": "^[a-fA-F0-9]{24}$" }, { "type": "null" }] },
          "dueDate": { "type": ["string", "null"], "format": "date-time" },
          "reminderAt": { "type": ["string", "null"], "format": "date-time", "description": "Requires dueDate and must not be later than it." }
        }
      },
      "TaskPatch": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "description": { "type": "string", "maxLength": 2000 },
          "status": { "$ref": "#/components/schemas/TaskStatus" },
          "priority": { "$ref": "#/components/schemas/Priority" },
          "category": { "oneOf": [{ "type": "string", "pattern": "^[a-fA-F0-9]{24}$" }, { "type": "null" }] },
          "dueDate": { "type": ["string", "null"], "format": "date-time" },
          "reminderAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "Task": {
        "type": "object",
        "required": ["_id", "title", "status", "priority"],
        "properties": {
          "_id": { "type": "string" },
          "title": { "type": "string", "maxLength": 160 },
          "description": { "type": "string", "maxLength": 2000 },
          "status": { "$ref": "#/components/schemas/TaskStatus" },
          "priority": { "$ref": "#/components/schemas/Priority" },
          "category": { "oneOf": [{ "$ref": "#/components/schemas/Category" }, { "type": "null" }] },
          "dueDate": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
          "reminderAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "TaskStatistics": {
        "type": "object",
        "properties": {
          "total": { "type": "integer" },
          "completed": { "type": "integer" },
          "inProgress": { "type": "integer" },
          "overdue": { "type": "integer" },
          "dueToday": { "type": "integer" },
          "completionRate": { "type": "integer", "minimum": 0, "maximum": 100 },
          "byPriority": { "type": "object", "additionalProperties": { "type": "integer" } }
        }
      },
      "Notification": {
        "type": "object",
        "required": ["_id", "type", "title", "message", "eventAt"],
        "properties": {
          "_id": { "type": "string" },
          "task": { "type": "object", "properties": { "_id": { "type": "string" }, "title": { "type": "string" }, "status": { "$ref": "#/components/schemas/TaskStatus" } } },
          "type": { "type": "string", "enum": ["reminder", "due"] },
          "title": { "type": "string" },
          "message": { "type": "string" },
          "eventAt": { "type": "string", "format": "date-time" },
          "readAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
        }
      },
      "TaskList": {
        "type": "object",
        "required": ["data", "pagination"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Task" } },
          "pagination": { "type": "object", "required": ["page", "limit", "total", "pages"], "properties": { "page": { "type": "integer" }, "limit": { "type": "integer" }, "total": { "type": "integer" }, "pages": { "type": "integer" } } }
        }
      },
      "ApiError": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" }, "details": { "type": "array", "items": { "type": "object" } } } }
    },
    "responses": {
      "BadRequest": { "description": "Invalid request or validation failure.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
      "Unauthorized": { "description": "Authentication required or session expired.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
      "NotFound": { "description": "Resource not found or not owned by current user.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
      "Conflict": { "description": "A unique value already exists.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
      "RateLimited": { "description": "Too many authentication attempts.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
    }
  }
}
